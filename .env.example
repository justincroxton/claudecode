# SAM.gov API key (free: https://sam.gov/data-services -> request public API key)
SAM_GOV_API_KEY=your_sam_gov_key_here

# Google Custom Search API (https://developers.google.com/custom-search/v1/overview)
# Create a Programmable Search Engine at https://programmablesearchengine.google.com
GOOGLE_CSE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_search_engine_id_here

# Optional: comma-separated Bonfire institution subdomains to scan
# e.g. gmu,vcu,ncsu  (resolves to gmu.bonfirehub.com etc.)
BONFIRE_INSTITUTIONS=gmu,vcu,ncsu,jmu,odu
